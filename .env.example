# =============================================================================
# Task Reminder — environment variables (template)
# =============================================================================
# Copy to ".env.local" for local development, and set each variable in the
# Vercel project dashboard for production deployments.
# =============================================================================

# --- MongoDB (required at runtime) ------------------------------------------
# Production: MongoDB Atlas connection string.
# Local dev:   mongodb://localhost:27017/task-reminder
MONGODB_URI=

# --- Authentication ---------------------------------------------------------
# Long random string used to sign JWT session tokens.
JWT_SECRET=

# --- Admin approval (eSewa / Khalti manual verification) --------------------
# Secret sent via header `x-admin-secret` or `?secret=` query param to
# /api/admin/subscriptions/approve
ADMIN_SECRET=
# Email address that should be promoted to the admin role on sign-in.
# (Defaults to SMTP_USER if not set.)
ADMIN_EMAIL=


# --- OTP policy -------------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# --- Web Push (VAPID) -------------------------------------------------------
# Generate a pair:  node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Cron security ----------------------------------------------------------
# Secret sent via `x-cron-secret` header or `?secret=` to cron API routes.
CRON_SECRET=

# --- Sparrow SMS gateway (https://sparrowsms.com) ---------------------------
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=TaskReminder

# --- Twilio (fallback SMS provider) -----------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Email ------------------------------------------------------------------
# Option A: Resend (set RESEND_API_KEY to use)
RESEND_API_KEY=
RESEND_FROM=

# Option B: Gmail SMTP (primary OTP channel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Default sender identity used by Nodemailer for OTP + reminder emails.
DEFAULT_FROM_EMAIL="Task System" <you@example.com>
SMTP_FROM="Task System" <you@example.com>
